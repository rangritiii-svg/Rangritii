rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ARTISTS ──────────────────────────────────────────────────────
    // Anyone can read approved artists (for the browse/search screens)
    // Only the artist themselves (matched by phone) or an admin can write.
    match /artists/{artistId} {
      allow read: if true;
      allow create: if true;   // Registration — open write so new artists can register
      allow update, delete: if true; // Relax for now; tighten after auth is added
    }

    // ── CUSTOMERS ────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // ── BOOKINGS ─────────────────────────────────────────────────────
    // Everyone can read and write for now (tighten after auth is wired)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // ── ADMIN SETTINGS ───────────────────────────────────────────────
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;   // Protect with admin auth later
    }

    // ── CHATS ────────────────────────────────────────────────────────
    match /chats/{conversationId}/messages/{msgId} {
      allow read, write: if true;
    }
  }
}
