# ── Supabase ──────────────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard → your project → Settings → API
# Leave them empty (or delete this file's copies) to run in DEMO MODE with
# built-in sample products and demo admin login.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key (never exposed to the browser). Required for admin panel
# writes (product/order management) when Supabase is configured.
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo admin credentials (used ONLY when Supabase is not configured) ─
# Change these before sharing a demo deployment.
DEMO_ADMIN_EMAIL=admin@rangritii.com
DEMO_ADMIN_PASSWORD=rangritii123
